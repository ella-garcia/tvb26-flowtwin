# Copy to .env (git-ignored) or set in the shell / Cloud Run secrets. Never commit values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: shared secret for the job endpoints (Authorization: Bearer <token>)
WORKER_TOKEN=
# Optional: path to the signals JSON for the file source (default: worker/data/seed_signals.json)
SIGNALS_FILE=

# --- Phase 2: live signals, notifications, schedule ---
# Comma-separated signal sources for POST /cron/hourly (default when empty: weather,tomtom,cbp,theft,file):
# weather (SMN days 1-3 + Open-Meteo days 4-14), open-meteo, smn, tomtom (road closures, blockades), cbp (US border truck waits),
# theft (corridor priors), file (seeded demo signals)
SIGNAL_SOURCES=
# TomTom Traffic incidents (WP1). Without it the tomtom source makes no request (dry-run)
TOMTOM_API_KEY=
# Email via Resend. Without RESEND_API_KEY nothing is sent: attempts are recorded in alert_notifications with status 'dry-run'
RESEND_API_KEY=
NOTIFY_FROM=
# Public URL of the web app; emails link to <APP_URL>/#alerts (customer) or <APP_URL>/#my-risk (supplier)
APP_URL=
