# Copy to .env (git-ignored) or set in the shell / Cloud Run secrets. Never commit values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: shared secret for the job endpoints (Authorization: Bearer <token>)
WORKER_TOKEN=
# Optional: path to the signals JSON for the file source (default: worker/data/seed_signals.json)
SIGNALS_FILE=
